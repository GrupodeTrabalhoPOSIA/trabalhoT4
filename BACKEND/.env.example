# Aplicação
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# Local: salvar como BACKEND/.env (env na raiz não é carregado).
# Render: cadastrar os mesmos nomes em Environment; variáveis do processo têm prioridade.
# OpenRouter — chave somente no backend; nunca usar prefixo VITE_ para segredos.
OPENROUTER_API_KEY=
# Obrigatório, sem fallback no código. Modelo escolhido para este projeto:
OPENROUTER_MODEL=mistralai/mistral-large
# Modelo usado no baseline histórico T2; vazio deixa a comparação pendente.
BASELINE_MODEL=mistralai/mistral-large
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_TOKENS=500
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_REFERER=http://localhost:5173
# Em produção, usar a URL pública do frontend em FRONTEND_ORIGIN e OPENROUTER_REFERER.
# FRONTEND_ORIGIN é a origem exata, sem / final, caminho ou #/entregas/4.
OPENROUTER_APP_TITLE=Aurora Tech Chatbot
# Obrigatório, sem padrão no código.
OPENROUTER_EMBEDDING_MODEL=mistralai/mistral-embed-2312
# Enviar dimensions somente se o modelo suportar; Mistral Embed usa dimensão fixa.
EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=64

# Supabase Session Pooler — copiar a URI da opção "Session pooler" (porta 5432)
SUPABASE_DB_URL=
SUPABASE_POOL_MIN_SIZE=1
SUPABASE_POOL_MAX_SIZE=5
SUPABASE_POOL_TIMEOUT_SECONDS=10

# RAG
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_RELEVANCE=0.35
MAX_CONTEXT_CHARACTERS=6000
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Limites
MAX_MESSAGE_LENGTH=2000
MAX_HISTORY_MESSAGES=10
MAX_UPLOAD_SIZE_MB=10
