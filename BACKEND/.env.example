# Aplicação
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# OpenRouter — preencher apenas no arquivo .env local
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_TOKENS=500
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=Aurora Tech Chatbot
OPENROUTER_EMBEDDING_MODEL=mistralai/mistral-embed-2312
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=64

# Supabase Session Pooler — copiar a URI da opção "Session pooler" (porta 5432)
SUPABASE_DB_URL=
SUPABASE_POOL_MIN_SIZE=1
SUPABASE_POOL_MAX_SIZE=5
SUPABASE_POOL_TIMEOUT_SECONDS=10

# RAG
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_RELEVANCE=0.35
MAX_CONTEXT_CHARACTERS=6000
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Limites
MAX_MESSAGE_LENGTH=2000
MAX_HISTORY_MESSAGES=10
MAX_UPLOAD_SIZE_MB=10
